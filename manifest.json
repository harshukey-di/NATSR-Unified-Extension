{
  "manifest_version": 3,
  "name": "NATSR Unified",
  "version": "1.0.0",
  "description": "AI-assisted form review, photo descriptions and autopilot for the NatsrUnified (LossControl360) platform. Side-panel UI with an Accept/Reject workflow.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://natsrunified.losscontrol360.com/*",
    "https://qagent.dhaninfo.ai/*"
  ],
  "action": {
    "default_title": "Open NATSR Unified",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://natsrunified.losscontrol360.com/Inspection/*",
        "https://natsrunified.losscontrol360.com/inspection/*"
      ],
      "js": [
        "page/dynforms-agent.js",
        "page/photos-agent.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://natsrunified.losscontrol360.com/Inspection/*",
        "https://natsrunified.losscontrol360.com/inspection/*"
      ],
      "js": [
        "common/forms.js",
        "content/bridge.js",
        "content/generalinfo.js",
        "content/highlighter.js",
        "content/imageModal.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}